# Backend Environment Configuration
FLASK_ENV=development
FLASK_DEBUG=True
HOST=0.0.0.0
PORT=5000

# Security Keys (CHANGE IN PRODUCTION)
SECRET_KEY=change-this-to-a-super-secret-key-12345
JWT_SECRET_KEY=change-this-to-a-super-secret-jwt-key-67890
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7

# Database Connection URL
DATABASE_URL=sqlite:///hackathon.db
# For PostgreSQL: postgresql://username:password@localhost:5432/crdt_db

# Redis Connection URL (Required in Production)
REDIS_URL=redis://localhost:6379/0

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
