# Root Environment File for AWS EC2 Deployment

# Flask Security Keys
SECRET_KEY=generate-a-strong-random-key-here
JWT_SECRET_KEY=generate-another-strong-random-key-here

# Allowed Frontend Origins (Comma separated or * for all)
CORS_ORIGINS=*

# Database URL
DATABASE_URL=sqlite:///hackathon.db

# Frontend API Base URL (leave /api if using Nginx reverse proxy)
VITE_API_BASE_URL=/api
